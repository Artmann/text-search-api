{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "text-search-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-16",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "text-search-prod"
    }
  ],
  "env": {
    "dev": {
      "ai": {
        "binding": "AI",
        "remote": true
      },
      "vectorize": [
        {
          "binding": "VECTORIZE",
          "index_name": "text-search-dev",
          "remote": true
        }
      ]
    }
  }
}
